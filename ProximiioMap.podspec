# Proximi.io iOS Map — BINARY distribution podspec (CocoaPods).
#
# Rendered per release by scripts/publish-binary-release.sh and committed to the
# distribution repo (proximiio/proximiio-map-ios-binary) beside Package.swift.
# The __PLACEHOLDER__ tokens become this release's version, the published
# Release-asset URL, its SHA-256 checksum, and the SDK and MapLibre versions the
# map was built against. Customers reference the TAGGED copy of this podspec, as
# they do the SDK's (see the distribution README). No CocoaPods trunk push.
#
# Design (mirrors the SwiftPM package and the SDK's podspec):
#   * vendored_frameworks ships the single flattened
#     `ProximiioMapBinary.xcframework` — the same zip, the same checksum, that
#     SwiftPM pins;
#   * a one-line source shim compiled into the public `ProximiioMap` module, so
#     integrators write `import ProximiioMap` as they do against the source
#     package. The `:http` source holds only the xcframework zip, so the shim is
#     materialised at install time by `prepare_command`;
#   * two pod dependencies, both at EXACTLY the versions the binary was built
#     against: `Proximiio` (the SDK's binary pod, referenced by its tagged
#     podspec — it is not on trunk either) and `MapLibre` (trunk).
#
# The shipped interface imports `Proximiio`, never the SDK's `ProximiioCore`:
# scripts/build-xcframeworks.sh rewrites that import while staging, because the
# SDK's pod vends one module, `Proximiio`, over the same `ProximiioBinary` the
# `ProximiioCore` shim re-exports under SwiftPM.
#
# MapLibre is NOT re-exported by the shim, as in the SwiftPM package: an app that
# wants `MLNMapView` in scope writes `import MapLibre` itself.

Pod::Spec.new do |s|
  s.name             = 'ProximiioMap'
  s.version          = '6.0.0-beta.56'
  s.summary          = 'Proximi.io iOS Map — the indoor map, blue dot, routes and journeys over MapLibre.'
  s.description      = <<-DESC
    Precompiled binary distribution of the Proximi.io iOS Map: the venue map over
    MapLibre Native, the position dot, floors, routes, geofences and journeys,
    driven by the Proximi.io iOS SDK. Ships as a single
    `ProximiioMapBinary.xcframework`; the source is proprietary and is not
    published.
  DESC
  s.homepage         = 'https://proximi.io'
  s.authors          = { 'Proximi.io' => 'support@proximi.io' }
  s.documentation_url = 'https://github.com/proximiio/proximiio-map-ios-binary'

  # Inline, because the `:http` source contains only the xcframework zip; the
  # LICENSE file lives in the distribution repo.
  s.license          = {
    :type => 'Commercial',
    :text => <<-LICENSE
      Proximi.io iOS Map — Proprietary, licensed not sold. Use is subject to a
      separate written commercial agreement with Proximi.io. See the LICENSE file
      in https://github.com/proximiio/proximiio-map-ios-binary for full terms.
      MapLibre Native is BSD-2-Clause; see NOTICES.md there.
    LICENSE
  }

  s.platform         = :ios, '15.0'
  s.swift_version    = '6.0'
  s.cocoapods_version = '>= 1.10.0'

  # The SAME SHA-256 SwiftPM pins (`swift package compute-checksum`).
  s.source           = { :http => 'https://github.com/proximiio/proximiio-map-ios-binary/releases/download/6.0.0-beta.56/ProximiioMapBinary.xcframework.zip', :sha256 => 'e72fc8ba803721757753c984125f80c0a77d4b7568aa825f171830ab0f1a1eee' }

  s.vendored_frameworks = 'ProximiioMapBinary.xcframework'

  s.source_files     = 'Sources/ProximiioMap/**/*.swift'
  s.prepare_command  = <<~CMD
    set -e
    mkdir -p Sources/ProximiioMap
    printf '%s\\n' \
      '// Generated by the ProximiioMap podspec prepare_command.' \
      '// Re-exports the precompiled ProximiioMapBinary module under the public ProximiioMap name.' \
      '@_exported import ProximiioMapBinary' \
      > Sources/ProximiioMap/Exports.swift
  CMD

  # Exactly the versions the binary was built against: a `.swiftinterface`
  # names SDK types by their defining module, and a MapLibre minor is an ABI.
  s.dependency 'Proximiio', '6.0.0-beta.67'
  s.dependency 'MapLibre', '6.29.0'
end
